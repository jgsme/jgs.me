{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "w-ap",
  "compatibility_date": "2025-08-28",
  "main": "src/index.ts",
  // 公開する口は全て web (w.jgs.me) が service binding で転送する
  // (server/routes/wellknown.ts, objects.ts)。ActivityPub は identity domain の
  // ホスト名でしか成立しないので workers.dev で受ける意味が無く、
  // 開けたままだと /internal/* が無認証のまま外から叩ける。
  "workers_dev": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "w",
      "database_id": "bd809baf-e2e6-41e2-9561-f77981b43ba5",
      "migrations_dir": "../db/drizzle",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "89b51739d36b4a32a7874a8066e11433",
    },
  ],
  "r2_buckets": [
    {
      // 記事本文。Scrapbox アーカイブと同居する。
      "binding": "R2",
      "bucket_name": "w-data",
    },
    {
      // 画像。r2.jgs.me で公開している (config.ts の MEDIA_BASE_URL)。
      // Webmention の h-card アバターをここに取り込む。
      "binding": "MEDIA",
      "bucket_name": "w-media",
    },
  ],
  "vars": {
    "BSKY_HANDLE": "jgs.me",
    // 初回セットアップで `GET https://graph.threads.net/v1.0/me?fields=id` を
    // 叩いて得た数値 id を入れる。空のままだと container 作成が失敗する。
    "THREADS_USER_ID": "",
  },
  // Threads の long-lived token は 60 日で失効する。週1で叩き直す。
  "triggers": {
    "crons": ["0 3 * * 1"],
  },
  "queues": {
    "producers": [
      {
        "binding": "DELIVERY",
        "queue": "ap-delivery",
      },
      {
        "binding": "WEBMENTION",
        "queue": "ap-webmention",
      },
      {
        "binding": "WM_SEND",
        "queue": "ap-wm-send",
      },
      {
        "binding": "BSKY",
        "queue": "ap-bsky",
      },
      {
        "binding": "THREADS_CREATE",
        "queue": "ap-threads-create",
      },
      {
        "binding": "THREADS_PUBLISH",
        "queue": "ap-threads-publish",
      },
    ],
    "consumers": [
      {
        "queue": "ap-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "ap-delivery-dlq",
      },
      {
        // source の取得は外部への fetch なので遅い相手に引きずられる。
        // batch を小さめにして1バッチが長引かないようにする。
        "queue": "ap-webmention",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 2,
        // 落ちた Webmention は他人からの寄与なので捨てない。consumer は
        // 付けない。読みたくなったら wrangler queues consumer http add で
        // pull consumer を後付けして HTTP で引ける。
        "dead_letter_queue": "ap-webmention-dlq",
      },
      {
        // discovery と送信で外部へ 2 回 fetch する。遅い相手に引きずられる
        // ので受信側と同じく batch を小さく保つ。
        "queue": "ap-wm-send",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 2,
      },
      {
        // Bluesky の書き込みは 5,000 ポイント/時 (CREATE は 3 ポイント) で
        // 急ぐ必要がない。1件ずつ処理して失敗の切り分けを楽にする。
        "queue": "ap-bsky",
        "max_batch_size": 1,
        "max_batch_timeout": 10,
        "max_retries": 3,
      },
      {
        // Threads は 250 投稿/24h で急ぐ必要がない。ap-bsky と同じく
        // 1件ずつ処理して失敗の切り分けを楽にする。
        "queue": "ap-threads-create",
        "max_batch_size": 1,
        "max_batch_timeout": 10,
        "max_retries": 3,
      },
      {
        "queue": "ap-threads-publish",
        "max_batch_size": 1,
        "max_batch_timeout": 10,
        "max_retries": 3,
      },
    ],
  },
}
