{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "w-ap",
  "compatibility_date": "2025-08-28",
  "main": "src/index.ts",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "w",
      "database_id": "bd809baf-e2e6-41e2-9561-f77981b43ba5",
      "migrations_dir": "../db/drizzle",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "89b51739d36b4a32a7874a8066e11433",
    },
  ],
  "r2_buckets": [
    {
      // 記事本文。Scrapbox アーカイブと同居する。
      "binding": "R2",
      "bucket_name": "w-data",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "DELIVERY",
        "queue": "ap-delivery",
      },
      {
        "binding": "WEBMENTION",
        "queue": "ap-webmention",
      },
    ],
    "consumers": [
      {
        "queue": "ap-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "ap-delivery-dlq",
      },
      {
        // source の取得は外部への fetch なので遅い相手に引きずられる。
        // batch を小さめにして1バッチが長引かないようにする。
        "queue": "ap-webmention",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 2,
      },
    ],
  },
}
