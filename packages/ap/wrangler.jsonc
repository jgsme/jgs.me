{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "w-ap",
  "compatibility_date": "2025-08-28",
  "main": "src/index.ts",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "w",
      "database_id": "bd809baf-e2e6-41e2-9561-f77981b43ba5",
      "migrations_dir": "../db/drizzle",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "89b51739d36b4a32a7874a8066e11433",
    },
  ],
}
