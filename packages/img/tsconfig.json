{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ESNext"],
    "types": ["@cloudflare/workers-types", "vite/client"],
    // vike-react は自動ランタイム。react-jsx でないと .tsx で React の
    // import が要るようになり、生成コードも旧ランタイムになる。
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src/**/*", "pages/**/*", "+server.ts", "vite.config.ts"]
}
