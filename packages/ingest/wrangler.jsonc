{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "w-ingest",
  "compatibility_date": "2025-08-28",
  "main": "src/index.ts",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "w",
      "database_id": "bd809baf-e2e6-41e2-9561-f77981b43ba5",
      "migrations_dir": "../db/drizzle",
    },
  ],
  "r2_buckets": [
    {
      // 記事本文。Scrapbox アーカイブと同居する。
      "binding": "R2",
      "bucket_name": "w-data",
    },
    {
      // Micropub media endpoint の画像。
      "binding": "MEDIA",
      "bucket_name": "w-media",
    },
  ],
  "vars": {
    "MEDIA_BASE_URL": "https://media.w.jgs.me",
  },
}
