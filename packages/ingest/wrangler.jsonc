{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "w-ingest",
  "compatibility_date": "2025-08-28",
  "main": "src/index.ts",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "w",
      "database_id": "bd809baf-e2e6-41e2-9561-f77981b43ba5",
      "migrations_dir": "../db/drizzle",
    },
  ],
  "r2_buckets": [
    {
      // 記事本文。Scrapbox アーカイブと同居する。
      "binding": "R2",
      "bucket_name": "w-data",
    },
    {
      // Micropub media endpoint の画像。
      "binding": "MEDIA",
      "bucket_name": "w-media",
    },
    {
      // 検索インデックス (AutoRAG w-rag) が食う md。原本とは別バケットに置く。
      // 同居させると原本の退避や作業用オブジェクトが全部インデックスされる
      // (gyazo-backup/ がそうなって検索結果が二重になった)。AutoRAG の
      // path filter は dashboard でしか触れず repo から見えないので、
      // バケットごと分けて設定に依存しない形にしてある。
      "binding": "MD",
      "bucket_name": "w-md",
    },
  ],
  "services": [
    {
      // 記事公開を ActivityPub の fan-out に繋ぐ内部呼び出し。
      "binding": "AP",
      "service": "w-ap",
    },
    {
      // 記事ページのエッジキャッシュを消す口 (POST /internal/purge)。
      // 更新した本文と改題を TTL 切れより前に出すために要る。
      "binding": "WEB",
      "service": "w",
    },
  ],
  "vars": {
    "MEDIA_BASE_URL": "https://r2.jgs.me",
  },
}
