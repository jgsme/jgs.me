{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "w-notify",
  "compatibility_date": "2025-08-28",
  "main": "src/index.ts",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "triggers": {
    "crons": ["0 20 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "w",
      "database_id": "bd809baf-e2e6-41e2-9561-f77981b43ba5",
      "migrations_dir": "../db/drizzle",
    },
  ],
  "workflows": [
    {
      "name": "notify-workflow",
      "binding": "NOTIFY_WORKFLOW",
      "class_name": "NotifyWorkflow",
    },
  ],
}
