{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "w-og",
  "compatibility_date": "2025-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.tsx",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "vars": {
    "ENVIRONMENT": "production",
  },
  "workflows": [
    {
      "name": "og-regenerate-workflow",
      "binding": "REGENERATE_WORKFLOW",
      "class_name": "RegenerateWorkflow",
    },
  ],
  "r2_buckets": [
    {
      "binding": "OG",
      "bucket_name": "w-og",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "w",
      "database_id": "bd809baf-e2e6-41e2-9561-f77981b43ba5",
      "migrations_dir": "../db/drizzle",
    },
  ],
}
